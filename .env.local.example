# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hera?retryWrites=true&w=majority

# Auth0
AUTH0_SECRET=<run: openssl rand -hex 32>
AUTH0_DOMAIN=<your-tenant>.us.auth0.com
AUTH0_CLIENT_ID=<your-client-id>
AUTH0_CLIENT_SECRET=<your-client-secret>
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Mapbox (public token for heatmap)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.<your-mapbox-token>

# AWS Bedrock (HeraBot AI agent)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-aws-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret>

# ML Services (optional — failsafes kick in if these are down)
CATEGORY_SERVICE_URL=http://127.0.0.1:8000
ML_SEVERITY_API_URL=https://<your-severity-model-url>/predict
